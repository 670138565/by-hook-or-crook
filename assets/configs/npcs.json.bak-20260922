0}],"connections":[]},"quests":[],"avatarCrop":{"cx":0.5111111111111111,"cy":0.145473411154345,"size":0.2599999999999999},"sprites":{"walk":"duojiji_walk.png","cols":8,"rows":5}},{"id":"npc_1789478248304","name":"行里西","gender":"男","identity":"新兵","portrait":"AIT20260915202921OBELHHBO-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":60,"y":180}],"connections":[]},"quests":[],"avatarCrop":{"cx":0.5083333333333333,"cy":0.15584954604409856,"size":0.2599999999999999},"sprites":{"walk":"xinglixi_walk.png","cols":8,"rows":5}},{"id":"npc_1789478249049","name":"肖哥","gender":"男","identity":"老兵","portrait":"AIT20260915202929LYYSKKNP-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":60,"y":180}],"connections":[]},"quests":[],"avatarCrop":{"cx":0.5194444444444445,"cy":0.15169909208819715,"size":0.2399999999999999},"sprites":{"walk":"xiaoge_walk.png","cols":8,"rows":5}},{"id":"npc_1789478261599","name":"呈彭非","gender":"男","identity":"炼金术士","portrait":"AIT202609152022094WBB1PGW-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":40,"y":40},{"id":"c_done","type":"condition","x":260,"y":20,"cond":"questDone","condValue":"q_cheng_oil","text":""},{"id":"n_done","type":"npc","x":520,"y":20,"text":"油用完了。药还在沸。你再来挡光，我就把你煮进下一锅。不完全是开玩笑。"},{"id":"e_done","type":"end","x":820,"y":20},{"id":"c_goals","type":"condition","x":520,"y":160,"cond":"questGoals","condValue":"q_cheng_oil","text":""},{"id":"k1","type":"complete","x":780,"y":140,"questId":"q_cheng_oil","text":""},{"id":"n_turn","type":"npc","x":1020,"y":140,"text":"油！放下。军用。这几个钱是军队的，不是我的人情。别闻我的脚，闻瓶子。"},{"id":"e_turn","type":"end","x":1320,"y":140},{"id":"c_act","type":"condition","x":780,"y":300,"cond":"questActive","condValue":"q_cheng_oil","text":""},{"id":"n_act","type":"npc","x":1040,"y":300,"text":"油瓶呢？没有就出去。灵感在沸，你在挡。"},{"id":"e_act","type":"end","x":1320,"y":300},{"id":"n1","type":"npc","x":1040,"y":440,"text":"药。药。别踩我的圈子。我是呈彭非。军队把我放在西南角，我给药，他们给敌人。"},{"id":"n2","type":"npc","x":1320,"y":440,"text":"你闻到了吗？也可能是我的脚。我不脱靴子。脱了，灵感就跑了。"},{"id":"ch","type":"choice","x":1580,"y":420,"text":"","options":[{"id":"o1","text":"你要是缺油，我可以去弄。"},{"id":"o2","text":"军用药，我不帮忙。"},{"id":"o3","text":"……主要是脚。"}]},{"id":"a1","type":"accept","x":1860,"y":340,"questId":"q_cheng_oil","text":""},{"id":"n_yes","type":"npc","x":2100,"y":340,"text":"一瓶油。普通的就行。送来。别问我配给谁喝。瓦拉几亚要赢，药水就不能停。"},{"id":"e_yes","type":"end","x":2380,"y":340},{"id":"n_no","type":"npc","x":1860,"y":520,"text":"不帮也好。少一个小偷闻我的锅。出去。"},{"id":"e_no","type":"end","x":2120,"y":520},{"id":"n_foot","type":"npc","x":1860,"y":660,"text":"灵感！你懂什么。脚是脚，胜利是胜利。你叫{名}也好，别挡住我的光。"},{"id":"e_foot","type":"end","x":2140,"y":660}],"connections":[{"from":"s","to":"c_done","port":"out"},{"from":"c_done","to":"n_done","port":"yes"},{"from":"n_done","to":"e_done","port":"out"},{"from":"c_done","to":"c_goals","port":"no"},{"from":"c_goals","to":"k1","port":"yes"},{"from":"k1","to":"n_turn","port":"out"},{"from":"n_turn","to":"e_turn","port":"out"},{"from":"c_goals","to":"c_act","port":"no"},{"from":"c_act","to":"n_act","port":"yes"},{"from":"n_act","to":"e_act","port":"out"},{"from":"c_act","to":"n1","port":"no"},{"from":"n1","to":"n2","port":"out"},{"from":"n2","to":"ch","port":"out"},{"from":"ch","to":"a1","port":"o1"},{"from":"a1","to":"n_yes","port":"out"},{"from":"n_yes","to":"e_yes","port":"out"},{"from":"ch","to":"n_no","port":"o2"},{"from":"n_no","to":"e_no","port":"out"},{"from":"ch","to":"n_foot","port":"o3"},{"from":"n_foot","to":"e_foot","port":"out"}]},"quests":[{"id":"q_cheng_oil","name":"军用的油","trigger":"dialogue","goals":[{"type":"item","itemId":"oil_bottle","consume":true}],"rewards":{"gold":40,"lockpicks":2,"xp":35,"items":[{"id":"fire_ointment","count":2},{"id":"fake_key","count":1}]}}],"avatarCrop":{"cx":0.5222222222222223,"cy":0.1433981841763943,"size":0.2599999999999999},"sprites":{"walk":"chengpengfei_walk.png","cols":8,"rows":5}},{"id":"npc_1789478268279","name":"央未由","gender":"女","identity":"农妇","portrait":"AIT202609152026026GUMG6FT-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":40,"y":40},{"id":"c_bd","type":"condition","x":260,"y":20,"cond":"questDone","condValue":"q_yang_bread","text":""},{"id":"n_bd","type":"npc","x":520,"y":20,"text":"面包我还记得。你再坐坐，{名}。清溪区冷清，可有人说话就不那么饿。"},{"id":"e_bd","type":"end","x":800,"y":20},{"id":"c_bg","type":"condition","x":520,"y":160,"cond":"questGoals","condValue":"q_yang_bread","text":""},{"id":"k_b","type":"complete","x":780,"y":140,"questId":"q_yang_bread","text":""},{"id":"n_bg","type":"npc","x":1020,"y":140,"text":"黑麦面包！硬是硬，可是热乎气……没有热乎气也行。我吃。你真把我当朋友了。"},{"id":"e_bg","type":"end","x":1300,"y":140},{"id":"c_ba","type":"condition","x":780,"y":300,"cond":"questActive","condValue":"q_yang_bread","text":""},{"id":"n_ba","type":"npc","x":1040,"y":300,"text":"面包还没影吗？没有也没关系，你人来了我就高兴。有的话我更高兴。我很诚实。"},{"id":"e_ba","type":"end","x":1340,"y":300},{"id":"c_flag","type":"condition","x":1040,"y":440,"cond":"hasFlag","condValue":"衣服送到了","text":""},{"id":"n_flag","type":"npc","x":1300,"y":440,"text":"衣服我叠好了。焕隆婆婆嘴毒，衣服干净。你还饿不饿？我是说我饿。"},{"id":"ch_flag","type":"choice","x":1580,"y":420,"text":"","options":[{"id":"o1","text":"我去找块面包给你。"},{"id":"o2","text":"迪丽奶那儿有热汤。"},{"id":"o3","text":"我先听你说。"}]},{"id":"a_b","type":"accept","x":1860,"y":340,"questId":"q_yang_bread","text":""},{"id":"e_ab","type":"end","x":2100,"y":340},{"id":"n_inn","type":"npc","x":1860,"y":480,"text":"酒吧？我一个人不敢进。你要是陪我，我就去。不陪也行，你记着我这张嘴。"},{"id":"e_inn","type":"end","x":2140,"y":480},{"id":"n_listen","type":"npc","x":1860,"y":620,"text":"太好了。我从瓦拉几亚来，听说这儿有好处。好处还没看见，朋友倒看见一个。国家的事我不太懂，你别考我。"},{"id":"e_listen","type":"end","x":2160,"y":620},{"id":"c_cloth","type":"condition","x":1300,"y":700,"cond":"questActive","condValue":"q_huanlong_clothes","text":""},{"id":"n_cloth","type":"npc","x":1560,"y":700,"text":"哎呀衣服！焕隆婆婆洗的吧？给我给我。","setFlag":"衣服送到了","takeItem":"old_clothes"},{"id":"n_cloth2","type":"npc","x":1820,"y":700,"text":"我叫央未由。你叫{名}？我记住了。我很饿。你要是以后有吃的，记得我。"},{"id":"e_cloth","type":"end","x":2100,"y":700},{"id":"n1","type":"npc","x":1560,"y":860,"text":"你你你，站住说说话！我叫央未由。听说这儿能过日子，结果街比我家院子还静。我想找个朋友，另外我很饿。"},{"id":"ch","type":"choice","x":1860,"y":840,"text":"","options":[{"id":"o1","text":"我可以听你说。我是{名}。"},{"id":"o2","text":"我帮你找点吃的。"},{"id":"o3","text":"我赶路。"}]},{"id":"n_hi","type":"npc","x":1560,"y":1020,"text":"{名}！国家谁打谁我不太懂。你下次一定要再来。"},{"id":"e_hi","type":"end","x":1820,"y":1020},{"id":"a1","type":"accept","x":2140,"y":900,"questId":"q_yang_bread","text":""},{"id":"n_food","type":"npc","x":2380,"y":900,"text":"黑麦面包就行，硬一点我也吃。你要是自己也饿，先吃你的。我可以再等。不能等太久。"},{"id":"e_food","type":"end","x":2660,"y":900},{"id":"n_bye","type":"npc","x":2140,"y":1040,"text":"哦。那你走吧。我还站在这儿。路比人多的时候，我会继续喊人的。"},{"id":"e_bye","type":"end","x":2420,"y":1040}],"connections":[{"from":"s","to":"c_bd","port":"out"},{"from":"c_bd","to":"n_bd","port":"yes"},{"from":"n_bd","to":"e_bd","port":"out"},{"from":"c_bd","to":"c_bg","port":"no"},{"from":"c_bg","to":"k_b","port":"yes"},{"from":"k_b","to":"n_bg","port":"out"},{"from":"n_bg","to":"e_bg","port":"out"},{"from":"c_bg","to":"c_ba","port":"no"},{"from":"c_ba","to":"n_ba","port":"yes"},{"from":"n_ba","to":"e_ba","port":"out"},{"from":"c_ba","to":"c_flag","port":"no"},{"from":"c_flag","to":"n_flag","port":"yes"},{"from":"n_flag","to":"ch_flag","port":"out"},{"from":"ch_flag","to":"a_b","port":"o1"},{"from":"a_b","to":"e_ab","port":"out"},{"from":"ch_flag","to":"n_inn","port":"o2"},{"from":"n_inn","to":"e_inn","port":"out"},{"from":"ch_flag","to":"n_listen","port":"o3"},{"from":"n_listen","to":"e_listen","port":"out"},{"from":"c_flag","to":"c_cloth","port":"no"},{"from":"c_cloth","to":"n_cloth","port":"yes"},{"from":"n_cloth","to":"n_cloth2","port":"out"},{"from":"n_cloth2","to":"e_cloth","port":"out"},{"from":"c_cloth","to":"n1","port":"no"},{"from":"n1","to":"ch","port":"out"},{"from":"ch","to":"n_hi","port":"o1"},{"from":"n_hi","to":"e_hi","port":"out"},{"from":"ch","to":"a1","port":"o2"},{"from":"a1","to":"n_food","port":"out"},{"from":"n_food","to":"e_food","port":"out"},{"from":"ch","to":"n_bye","port":"o3"},{"from":"n_bye","to":"e_bye","port":"out"}]},"quests":[{"id":"q_yang_bread","name":"给她一点吃的","trigger":"dialogue","goals":[{"type":"item","itemId":"rye_bread","consume":true}],"rewards":{"gold":20,"lockpicks":2,"xp":24,"items":[{"id":"stew","count":1},{"id":"energy_potion","count":1}]}}],"avatarCrop":{"cx":0.5166666666666667,"cy":0.15584954604409856,"size":0.2599999999999999},"sprites":{"walk":"yangweiyou_walk.png","cols":8,"rows":5}},{"id":"npc_1789478277359","name":"焕隆","gender":"女","identity":"洗衣老妇","portrait":"AIT202609152026554EGSDMVP-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":40,"y":40},{"id":"c_done","type":"condition","x":260,"y":20,"cond":"questDone","condValue":"q_huanlong_clothes","text":""},{"id":"n_done","type":"npc","x":520,"y":20,"text":"送到就送到了。别指望我谢你。"},{"id":"e_done","type":"end","x":780,"y":20},{"id":"c_goals","type":"condition","x":520,"y":160,"cond":"questGoals","condValue":"q_huanlong_clothes","text":""},{"id":"k1","type":"complete","x":780,"y":140,"questId":"q_huanlong_clothes","text":""},{"id":"n_turn","type":"npc","x":1020,"y":140,"text":"哼。没偷走。这几个钱拿去，当我雇你跑腿。别挨着我。"},{"id":"e_turn","type":"end","x":1300,"y":140},{"id":"c_act","type":"condition","x":780,"y":300,"cond":"questActive","condValue":"q_huanlong_clothes","text":""},{"id":"n_act","type":"npc","x":1040,"y":300,"text":"还杵着？央未由。衣服。现在。"},{"id":"e_act","type":"end","x":1300,"y":300},{"id":"n1","type":"npc","x":1040,"y":440,"text":"看什么看。我是焕隆。洗衣服的。第一批从瓦拉几亚来的。我谁都不信。"},{"id":"n2","type":"npc","x":1300,"y":440,"text":"衣服刚洗好。央未由话多，我懒得见。你要是敢偷，我闻得出来。"},{"id":"ch","type":"choice","x":1580,"y":420,"text":"","options":[{"id":"o1","text":"我送去。"},{"id":"o2","text":"为什么找我这个陌生人？"},{"id":"o3","text":"我不跑腿。"}]},{"id":"a1","type":"accept","x":1860,"y":340,"questId":"q_huanlong_clothes","text":""},{"id":"n_yes","type":"npc","x":2100,"y":340,"text":"快去。瓦拉几亚来的就该帮瓦拉几亚人。别在我眼前喘气。"},{"id":"e_yes","type":"end","x":2360,"y":340},{"id":"n_why","type":"npc","x":1860,"y":500,"text":"因为我认识的人，我更不信。陌生人偷一次，我还能骂。熟人偷，我会失望。我不喜欢失望。"},{"id":"e_why","type":"end","x":2160,"y":500},{"id":"n_no","type":"npc","x":1860,"y":660,"text":"那就滚。衣服我自己也能扔到她脸上。我只是不想见她那张笑脸。"},{"id":"e_no","type":"end","x":2160,"y":660}],"connections":[{"from":"s","to":"c_done","port":"out"},{"from":"c_done","to":"n_done","port":"yes"},{"from":"n_done","to":"e_done","port":"out"},{"from":"c_done","to":"c_goals","port":"no"},{"from":"c_goals","to":"k1","port":"yes"},{"from":"k1","to":"n_turn","port":"out"},{"from":"n_turn","to":"e_turn","port":"out"},{"from":"c_goals","to":"c_act","port":"no"},{"from":"c_act","to":"n_act","port":"yes"},{"from":"n_act","to":"e_act","port":"out"},{"from":"c_act","to":"n1","port":"no"},{"from":"n1","to":"n2","port":"out"},{"from":"n2","to":"ch","port":"out"},{"from":"ch","to":"a1","port":"o1"},{"from":"a1","to":"n_yes","port":"out"},{"from":"n_yes","to":"e_yes","port":"out"},{"from":"ch","to":"n_why","port":"o2"},{"from":"n_why","to":"e_why","port":"out"},{"from":"ch","to":"n_no","port":"o3"},{"from":"n_no","to":"e_no","port":"out"}]},"quests":[{"id":"q_huanlong_clothes","name":"把衣服送去","trigger":"dialogue","goals":[{"type":"flag","flag":"衣服送到了"}],"rewards":{"gold":32,"xp":30,"expandPoints":1,"items":[{"id":"linen_tunic","count":1},{"id":"healing_potion","count":1}]},"grants":{"items":[{"itemId":"old_clothes","count":1}]}}],"avatarCrop":{"cx":0.5111111111111111,"cy":0.145473411154345,"size":0.2599999999999999},"sprites":{"walk":"caixutushen_walk.png","cols":8,"rows":5}},{"id":"lingzhi","name":"灵芝老头","gender":"","identity":"","portrait":"","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":40,"y":40},{"id":"c_talk","type":"condition","x":260,"y":40,"cond":"talked","condValue":"@SELF","text":""},{"id":"n_back","type":"npc","x":520,"y":40,"text":"又来啦。小灵芝别摘。"},{"id":"ch_back","type":"choice","x":780,"y":20,"text":"","options":[{"id":"o1","text":"军队会不会进黑森林？"},{"id":"o2","text":"牛会走进这林子吗？"},{"id":"o3","text":"我坐一会儿。"}]},{"id":"n_b1","type":"npc","x":1080,"y":0,"text":"会来的人，闻到土腥就回头。不回头的，我当蛀虫。你别带路。"},{"id":"e_b1","type":"end","x":1340,"y":0},{"id":"n_b2","type":"npc","x":1080,"y":140,"text":"牛不喜欢湿黑的地方。丢了的牛，不在我这。往大路上去找，别在菌盖底下找。"},{"id":"e_b2","type":"end","x":1360,"y":140},{"id":"n_b3","type":"npc","x":1080,"y":280,"text":"坐。蘑菇不赶客，也不留客吃饭。没有饭。"},{"id":"e_b3","type":"end","x":1340,"y":280},{"id":"n1","type":"npc","x":520,"y":240,"text":"嘿嘿。灵芝看见你了。我是灵芝，也是老头。西边黑森林。籍贯算艾尔登。打仗的事，蘑菇不管。"},{"id":"ch","type":"choice","x":820,"y":220,"text":"","options":[{"id":"o1","text":"你不怕外面的军队？"},{"id":"o2","text":"能给我一朵灵芝吗？"},{"id":"o3","text":"我只是路过。"}]},{"id":"n_a","type":"npc","x":1100,"y":160,"text":"怕。所以我不出去。菌子最聪明，都长在没人砍的地方。你叫{名}也行，蘑菇听名不听姓。"},{"id":"e_a","type":"end","x":1380,"y":160},{"id":"n_b","type":"npc","x":1100,"y":320,"text":"小的不能摘。大的还没到能送人的时候。你再来，也许我高兴。也许菌盖还小。别催，催了它记仇。"},{"id":"e_b","type":"end","x":1400,"y":320},{"id":"n_c","type":"npc","x":1100,"y":460,"text":"路过就轻点踩。这林子不是路。"},{"id":"e_c","type":"end","x":1360,"y":460}],"connections":[{"from":"s","to":"c_talk","port":"out"},{"from":"c_talk","to":"n_back","port":"yes"},{"from":"n_back","to":"ch_back","port":"out"},{"from":"ch_back","to":"n_b1","port":"o1"},{"from":"ch_back","to":"n_b2","port":"o2"},{"from":"ch_back","to":"n_b3","port":"o3"},{"from":"n_b1","to":"e_b1","port":"out"},{"from":"n_b2","to":"e_b2","port":"out"},{"from":"n_b3","to":"e_b3","port":"out"},{"from":"c_talk","to":"n1","port":"no"},{"from":"n1","to":"ch","port":"out"},{"from":"ch","to":"n_a","port":"o1"},{"from":"ch","to":"n_b","port":"o2"},{"from":"ch","to":"n_c","port":"o3"},{"from":"n_a","to":"e_a","port":"out"},{"from":"n_b","to":"e_b","port":"out"},{"from":"n_c","to":"e_c","port":"out"}]},"quests":[],"sprites":{"walk":"lingzhi_walk.png","cols":8,"rows":5}}]}