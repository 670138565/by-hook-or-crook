  "npcs": [
    {
      "id": "farmer_hello",
      "name": "狗剩",
      "gender": "男",
      "identity": "村口的农夫",
      "portrait": "AIT20260915201609RIZILDWM-转换参考图的画风为2D中世纪游戏资产风格手绘插画，纯白背景-1.png",
      "avatar": "",
