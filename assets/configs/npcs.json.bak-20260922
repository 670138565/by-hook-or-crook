"naer_walk.png","cols":8,"rows":5}},{"id":"npc_1789478169233","name":"后加恒","gender":"男","identity":"地精","portrait":"AIT20260915202235H3JV8Z3F-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":60,"y":180}],"connections":[]},"quests":[],"avatarCrop":{"cx":0.4722222222222222,"cy":0.21603112840466926,"size":0.4},"sprites":{"walk":"houjiaheng_walk.png","cols":8,"rows":5}},{"id":"npc_1789478180751","name":"前加亨","gender":"男","identity":"地精","portrait":"AIT20260915202246H2NOMLVB-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":60,"y":180}],"connections":[]},"quests":[],"avatarCrop":{"cx":0.5,"cy":0.16,"size":0.38},"sprites":{"walk":"qianjiaheng_walk.png","cols":8,"rows":5}},{"id":"npc_1789478185903","name":"可比布·莱恩特","gender":"不详","identity":"？？？","portrait":"AIT20260915202256XSP71YC8-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":40,"y":200},{"id":"cond_done","type":"condition","x":-200,"y":40,"cond":"questDone","condValue":"q1789487070730","text":""},{"id":"n_thanks","type":"npc","x":80,"y":-40,"text":"釘子我收下了。你是個好人……對我這種人來說。"},{"id":"e_thanks","type":"end","x":360,"y":-40,"text":""},{"id":"cond_goals","type":"condition","x":-200,"y":160,"cond":"questGoals","condValue":"q1789487070730","text":""},{"id":"complete_nail","type":"complete","x":80,"y":160,"text":"","questId":"q1789487070730"},{"id":"n_got","type":"npc","x":340,"y":160,"text":"就是這根。拿著，別問我拿它幹什麼，也別告訴別人你在幫我。"},{"id":"e_got","type":"end","x":620,"y":160,"text":""},{"id":"cond_active","type":"condition","x":-200,"y":280,"cond":"questActive","condValue":"q1789487070730","text":""},{"id":"n_wait","type":"npc","x":80,"y":280,"text":"釘子還在穀倉那口木箱裏。你去開就行。"},{"id":"e_wait","type":"end","x":360,"y":280,"text":""},{"id":"n_hi","type":"npc","x":80,"y":420,"text":"額……人類，你好。"},{"id":"c_look","type":"choice","x":360,"y":420,"text":"","options":[{"id":"o1","text":"你看起来好奇怪","flag":""},{"id":"o2","text":"你看起来真美！","flag":""}]},{"id":"n_deny","type":"npc","x":640,"y":340,"text":"你看錯了。我只是一個普通的人類，和你們一樣。"},{"id":"c_alien","type":"choice","x":920,"y":340,"text":"","options":[{"id":"o1","text":"你是一个外星人。","flag":""},{"id":"o2","text":"嗯……应该是我看错了","flag":""}]},{"id":"n_flatter","type":"npc","x":640,"y":520,"text":"真的嗎？真讓我沒想到……謝謝？"},{"id":"c_sincere","type":"choice","x":920,"y":520,"text":"","options":[{"id":"o1","text":"我只是随便说说","flag":""},{"id":"o2","text":"是真的。","flag":""}]},{"id":"n_awkward","type":"npc","x":1200,"y":420,"text":"額……"},{"id":"p_ask","type":"player","x":1480,"y":420,"text":"你身后那个看起来像大盘子的是什么东西？"},{"id":"n_crash","type":"npc","x":1760,"y":420,"text":"那是我的飛船，但不小心墜毀了。現在我的確很無助。你要是肯幫我弄一樣東西，我可以給你格羅申。"},{"id":"c_help","type":"choice","x":2040,"y":420,"text":"","options":[{"id":"o1","text":"我可以帮你","flag":""},{"id":"o2","text":"把你的宝贝给我！！","flag":""},{"id":"o3","text":"算了，我还有别的事","flag":""}]},{"id":"accept_nail","type":"accept","x":2320,"y":300,"text":"","questId":"q1789487070730"},{"id":"n_quest","type":"npc","x":2600,"y":300,"text":"穀倉那邊那口木箱裏有根生鏽鐵釘。拿來給我，我給你格羅申和開鎖器——事後馬上給你。"},{"id":"e_quest","type":"end","x":2880,"y":300,"text":""},{"id":"n_rob","type":"npc","x":2320,"y":480,"text":"不！你想搶劫我？"},{"id":"c_rob","type":"choice","x":2600,"y":480,"text":"","options":[{"id":"o1","text":"废话少说！！！","flag":""},{"id":"o2","text":"我只是开玩笑","flag":""}]},{"id":"b_rob","type":"battle","x":2880,"y":440,"text":"","enemyId":"","enemyKind":"guard"},{"id":"n_bye","type":"npc","x":2320,"y":620,"text":"好吧……那你忙。"},{"id":"e_bye","type":"end","x":2600,"y":620,"text":""}],"connections":[{"from":"s","to":"cond_done","port":"out"},{"from":"cond_done","to":"n_thanks","port":"yes"},{"from":"n_thanks","to":"e_thanks","port":"out"},{"from":"cond_done","to":"cond_goals","port":"no"},{"from":"cond_goals","to":"complete_nail","port":"yes"},{"from":"complete_nail","to":"n_got","port":"out"},{"from":"n_got","to":"e_got","port":"out"},{"from":"cond_goals","to":"cond_active","port":"no"},{"from":"cond_active","to":"n_wait","port":"yes"},{"from":"n_wait","to":"e_wait","port":"out"},{"from":"cond_active","to":"n_hi","port":"no"},{"from":"n_hi","to":"c_look","port":"out"},{"from":"c_look","to":"n_deny","port":"o1"},{"from":"c_look","to":"n_flatter","port":"o2"},{"from":"n_deny","to":"c_alien","port":"out"},{"from":"c_alien","to":"n_awkward","port":"o1"},{"from":"c_alien","to":"n_awkward","port":"o2"},{"from":"n_flatter","to":"c_sincere","port":"out"},{"from":"c_sincere","to":"n_awkward","port":"o1"},{"from":"c_sincere","to":"n_awkward","port":"o2"},{"from":"n_awkward","to":"p_ask","port":"out"},{"from":"p_ask","to":"n_crash","port":"out"},{"from":"n_crash","to":"c_help","port":"out"},{"from":"c_help","to":"accept_nail","port":"o1"},{"from":"accept_nail","to":"n_quest","port":"out"},{"from":"n_quest","to":"e_quest","port":"out"},{"from":"c_help","to":"n_rob","port":"o2"},{"from":"n_rob","to":"c_rob","port":"out"},{"from":"c_rob","to":"b_rob","port":"o1"},{"from":"c_rob","to":"c_help","port":"o2"},{"from":"c_help","to":"n_bye","port":"o3"},{"from":"n_bye","to":"e_bye","port":"out"}]},"quests":[{"id":"q1789487070730","name":"谷仓的钉子","trigger":"dialogue","goals":[{"type":"item","consume":true,"itemId":"rusty_nail"}],"rewards":{"gold":28,"lockpicks":3,"xp":28,"items":[{"id":"dagger","count":1}]}}],"avatarCrop":{"cx":0.5472222222222223,"cy":0.15792477302204927,"size":0.29999999999999993},"_sel":"b1789486523785","sprites":{"walk":"kebibu_walk.png","cols":8,"rows":5}},{"id":"npc_1789478191441","name":"胡昂·穆兰","gender":"男","identity":"贪婪收藏家","portrait":"AIT20260915202304BKNITBHP-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":60,"y":180}],"connections":[]},"quests":[],"avatarCrop":{"cx":0.5,"cy":0.1433981841763943,"size":0.2599999999999999},"sprites":{"walk":"huangmulan_walk.png","cols":8,"rows":5}},{"id":"npc_1789478198311","name":"韩芹","gender":"女","identity":"占卜师","portrait":"AIT20260915202313INGSX44D-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":40,"y":40},{"id":"c_talk","type":"condition","x":260,"y":40,"cond":"talked","condValue":"@SELF","text":""},{"id":"n_back","type":"npc","x":520,"y":40,"text":"看过一次了。再看就是贪。"},{"id":"ch_back","type":"choice","x":780,"y":20,"text":"","options":[{"id":"o1","text":"那条借来的名字还护得住吗？"},{"id":"o2","text":"你到底是真算还是假算？"},{"id":"o3","text":"我不问了。"}]},{"id":"n_b1","type":"npc","x":1080,"y":0,"text":"护一阵。护不住的时候，别怪骨头。我只说我看见的。"},{"id":"e_b1","type":"end","x":1340,"y":0},{"id":"n_b2","type":"npc","x":1080,"y":140,"text":"你分不清，才需要问。分得清的人，不会站在我车辕旁边。"},{"id":"e_b2","type":"end","x":1360,"y":140},{"id":"n_b3","type":"npc","x":1080,"y":280,"text":"好。线收着。"},{"id":"e_b3","type":"end","x":1300,"y":280},{"id":"n1","type":"npc","x":520,"y":240,"text":"你脸上有两条线。一条是你自己的，一条是借来的。"},{"id":"ch","type":"choice","x":800,"y":220,"text":"","options":[{"id":"o1","text":"借来的那条，能不能用？"},{"id":"o2","text":"这场仗你看到头了吗？"},{"id":"o3","text":"不必给我看。"}]},{"id":"n_a","type":"npc","x":1080,"y":160,"text":"我叫韩芹。从很南边来，马车把我丢在这儿。借来的名字能护你一阵。我只给有缘的人看。你算一个，别高兴太早。"},{"id":"e_a","type":"end","x":1380,"y":160},{"id":"n_b","type":"npc","x":1080,"y":320,"text":"看到清洗的人会来。看到你不想死。再往后，是雾。雾不是谎话，是我真的看不见。"},{"id":"e_b","type":"end","x":1360,"y":320},{"id":"n_c","type":"npc","x":1080,"y":460,"text":"那你走。有的人不是我的缘。你刚刚差点是。"},{"id":"e_c","type":"end","x":1340,"y":460}],"connections":[{"from":"s","to":"c_talk","port":"out"},{"from":"c_talk","to":"n_back","port":"yes"},{"from":"n_back","to":"ch_back","port":"out"},{"from":"ch_back","to":"n_b1","port":"o1"},{"from":"ch_back","to":"n_b2","port":"o2"},{"from":"ch_back","to":"n_b3","port":"o3"},{"from":"n_b1","to":"e_b1","port":"out"},{"from":"n_b2","to":"e_b2","port":"out"},{"from":"n_b3","to":"e_b3","port":"out"},{"from":"c_talk","to":"n1","port":"no"},{"from":"n1","to":"ch","port":"out"},{"from":"ch","to":"n_a","port":"o1"},{"from":"ch","to":"n_b","port":"o2"},{"from":"ch","to":"n_c","port":"o3"},{"from":"n_a","to":"e_a","port":"out"},{"from":"n_b","to":"e_b","port":"out"},{"from":"n_c","to":"e_c","port":"out"}]},"quests":[],"avatarCrop":{"cx":0.5111111111111111,"cy":0.1475486381322957,"size":0.2599999999999999},"sprites":{"walk":"hanqin_walk.png","cols":8,"rows":5}},{"id":"npc_1789478205856","name":"吉多多","gender":"男","identity":"农夫","portrait":"AIT20260915202554JOSL0QAR-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":60,"y":180}],"connections":[]},"quests":[],"avatarCrop":{"cx":0.5083333333333333,"cy":0.13302204928664074,"size":0.2399999999999999},"sprites":{"walk":"jiduoduo_walk.png","cols":8,"rows":5}},{"id":"npc_1789478211176","name":"老鸦","gender":"男","identity":"村长","portrait":"AIT20260915202610OKAZ5RHA-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":40,"y":40},{"id":"c_done","type":"condition","x":260,"y":20,"cond":"questDone","condValue":"q_laoya_hand","text":""},{"id":"n_done","type":"npc","x":500,"y":20,"text":"亨利。手还记得吗？不认识的人面前，你是{名}。"},{"id":"ch_done","type":"choice","x":760,"y":20,"text":"","options":[{"id":"o1","text":"教堂村的神父呢？"},{"id":"o2","text":"我该躲着谁？"},{"id":"o3","text":"我自己去看。"}]},{"id":"n_d1","type":"npc","x":1040,"y":0,"text":"乌昂神父认得你。他弟弟在林子里砍柴，不信神，可惦记他。你去看，别报我的名字。"},{"id":"e_d1","type":"end","x":1320,"y":0},{"id":"n_d2","type":"npc","x":1040,"y":120,"text":"守卫队长多吉吉，还有那个凶的民兵行里东。侯凯·扬爱睡觉，行里西自己先怕。别跟队长试嘴。"},{"id":"e_d2","type":"end","x":1320,"y":120},{"id":"n_d3","type":"npc","x":1040,"y":240,"text":"去。活着回来就行。"},{"id":"e_d3","type":"end","x":1280,"y":240},{"id":"c_goals","type":"condition","x":500,"y":200,"cond":"questGoals","condValue":"q_laoya_hand","text":""},{"id":"k1","type":"complete","x":760,"y":180,"questId":"q_laoya_hand","text":""},{"id":"n_turn","type":"npc","x":1000,"y":180,"text":"打开了？没听见响才好。面包你留着吃。这两根开锁器拿着。"},{"id":"e_turn","type":"end","x":1280,"y":180},{"id":"c_act","type":"condition","x":760,"y":340,"cond":"questActive","condValue":"q_laoya_hand","text":""},{"id":"n_act","type":"npc","x":1020,"y":340,"text":"那口箱子还没开。左下方横着的木屋，进门就是屋角的木箱。"},{"id":"ch_act","type":"choice","x":1280,"y":340,"text":"","options":[{"id":"o1","text":"我这就去。"},{"id":"o2","text":"要是被人看见呢？"}]},{"id":"n_a1","type":"npc","x":1540,"y":300,"text":"去。轻一点。"},{"id":"e_a1","type":"end","x":1760,"y":300},{"id":"n_a2","type":"npc","x":1540,"y":420,"text":"看见了就别跑。跑的人像贼。你现在的名字是{名}，把这句话说顺。"},{"id":"e_a2","type":"end","x":1800,"y":420},{"id":"c_talk","type":"condition","x":1020,"y":520,"cond":"talked","condValue":"@SELF","text":""},{"id":"n_again","type":"npc","x":1280,"y":520,"text":"亨利。名字不用再教。那口箱子呢？"},{"id":"ch_again","type":"choice","x":1540,"y":520,"text":"","options":[{"id":"o1","text":"我去开。"},{"id":"o2","text":"再等一等。"}]},{"id":"a_again","type":"accept","x":1800,"y":480,"questId":"q_laoya_hand","text":""},{"id":"n_ag","type":"npc","x":2040,"y":480,"text":"左下方，屋角的木箱。打开再回来。"},{"id":"e_ag","type":"end","x":2280,"y":480},{"id":"n_wait","type":"npc","x":1800,"y":620,"text":"等可以。清洗的人不会等你。"},{"id":"e_wait","type":"end","x":2060,"y":620},{"id":"n1","type":"npc","x":1280,"y":760,"text":"亨利。你还活着。"},{"id":"n2","type":"npc","x":1540,"y":760,"text":"灰鸦村没了。他们留下我，给后面的清洗部队带路。时间不多。"},{"id":"ch1","type":"choice","x":1800,"y":740,"text":"","options":[{"id":"o1","text":"那我们怎么活？"},{"id":"o2","text":"你为什么不逃？"},{"id":"o3","text":"我自己再想想。"}]},{"id":"n_how","type":"npc","x":1280,"y":960,"text":"路走得了，脸走不了。不认识你的人要一个瓦拉几亚名字。你来起。想不出就叫行商。"},{"id":"n_why","type":"npc","x":1540,"y":1100,"text":"我逃了，他们会拿别的活人开刀。我留下，是拖时间。你不一样。你得有个名字。"},{"id":"n_name","type":"npc","x":1800,"y":1040,"text":"就这个。不熟的人面前你是{名}。我还叫你亨利。","askAlias":true},{"id":"n_job","type":"npc","x":2060,"y":1040,"text":"左下方那座横着的木屋，进门屋角的木箱。打开它。里面有块黑麦面包，练的是手。"},{"id":"ch_job","type":"choice","x":1280,"y":1240,"text":"","options":[{"id":"o1","text":"我去开那口箱子。"},{"id":"o2","text":"我还没准备好。"}]},{"id":"a1","type":"accept","x":1560,"y":1180,"questId":"q_laoya_hand","text":""},{"id":"n_go","type":"npc","x":1800,"y":1180,"text":"去吧。别跟守卫说话。"},{"id":"e_go","type":"end","x":2060,"y":1180},{"id":"n_later","type":"npc","x":1560,"y":1320,"text":"准备。别准备到他们进村。"},{"id":"e_later","type":"end","x":1820,"y":1320},{"id":"n_think","type":"npc","x":2060,"y":760,"text":"想。想完回来。别用亨利这个名字出门。"},{"id":"e_think","type":"end","x":2320,"y":760}],"connections":[{"from":"s","to":"c_done","port":"out"},{"from":"c_done","to":"n_done","port":"yes"},{"from":"n_done","to":"ch_done","port":"out"},{"from":"ch_done","to":"n_d1","port":"o1"},{"from":"ch_done","to":"n_d2","port":"o2"},{"from":"ch_done","to":"n_d3","port":"o3"},{"from":"n_d1","to":"e_d1","port":"out"},{"from":"n_d2","to":"e_d2","port":"out"},{"from":"n_d3","to":"e_d3","port":"out"},{"from":"c_done","to":"c_goals","port":"no"},{"from":"c_goals","to":"k1","port":"yes"},{"from":"k1","to":"n_turn","port":"out"},{"from":"n_turn","to":"e_turn","port":"out"},{"from":"c_goals","to":"c_act","port":"no"},{"from":"c_act","to":"n_act","port":"yes"},{"from":"n_act","to":"ch_act","port":"out"},{"from":"ch_act","to":"n_a1","port":"o1"},{"from":"ch_act","to":"n_a2","port":"o2"},{"from":"n_a1","to":"e_a1","port":"out"},{"from":"n_a2","to":"e_a2","port":"out"},{"from":"c_act","to":"c_talk","port":"no"},{"from":"c_talk","to":"n_again","port":"yes"},{"from":"n_again","to":"ch_again","port":"out"},{"from":"ch_again","to":"a_again","port":"o1"},{"from":"a_again","to":"n_ag","port":"out"},{"from":"n_ag","to":"e_ag","port":"out"},{"from":"ch_again","to":"n_wait","port":"o2"},{"from":"n_wait","to":"e_wait","port":"out"},{"from":"c_talk","to":"n1","port":"no"},{"from":"n1","to":"n2","port":"out"},{"from":"n2","to":"ch1","port":"out"},{"from":"ch1","to":"n_how","port":"o1"},{"from":"ch1","to":"n_why","port":"o2"},{"from":"ch1","to":"n_think","port":"o3"},{"from":"n_how","to":"n_name","port":"out"},{"from":"n_why","to":"n_name","port":"out"},{"from":"n_name","to":"n_job","port":"out"},{"from":"n_job","to":"ch_job","port":"out"},{"from":"ch_job","to":"a1","port":"o1"},{"from":"a1","to":"n_go","port":"out"},{"from":"n_go","to":"e_go","port":"out"},{"from":"ch_job","to":"n_later","port":"o2"},{"from":"n_later","to":"e_later","port":"out"},{"from":"n_think","to":"e_think","port":"out"}]},"quests":[{"id":"q_laoya_hand","name":"先练一次手","trigger":"dialogue","goals":[{"type":"chest","chestId":"i_practice_rye"}],"rewards":{"gold":15,"lockpicks":3,"xp":22,"expandPoints":1,"items":[{"id":"healing_potion","count":1}]}}],"avatarCrop":{"cx":0.5888888888888889,"cy":0.16,"size":0.2599999999999999},"sprites":{"walk":"laoya_walk.png","cols":8,"rows":5}},{"id":"npc_1789478215903","name":"小亮","gender":"男","identity":"牧童","portrait":"AIT20260915202625LSX7Z56O-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":60,"y":180}],"connections":[]},"quests":[],"avatarCrop":{"cx":0.5055555555555555,"cy":0.14962386511024645,"size":0.2799999999999999},"sprites":{"walk":"xiaoliang_walk.png","cols":8,"rows":5}},{"id":"npc_1789478220881","name":"忘责义","gender":"男","identity":"酒鬼","portrait":"AIT20260915202635ZN9Q9QVT-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":60,"y":180}],"connections":[]},"quests":[],"avatarCrop":{"cx":0.5083333333333333,"cy":0.13302204928664074,"size":0.2399999999999999},"sprites":{"walk":"wangzeyi_walk.png","cols":8,"rows":5}},{"id":"npc_1789478225968","name":"乌昂·子睿","gender":"男","identity":"樵夫","portrait":"AIT20260915202648D0NCWBFB-512x768-pixels,-full-body-standing-portr-1.png","avatar":"","moods":[],"graph":{"nodes":[{"id":"s","type":"start","x":40,"y":40},{"id":"c_done","type":"condition","x":260,"y":20,"cond":"questDone","condValue":"q_zirui_brother","text":""},{"id":"n_done","type":"npc","x":520,"y":20,"text":"他真的还在教堂里。那个固执的家伙。我不回去。你替我看见了，就够了。"},{"id":"e_done","type":"end","x":800,"y":20},{"id":"c_goals","type":"condition","x":520,"y":160,"cond":"questGoals","condValue":"q_zirui_brother","text":""},{"id":"k1","type":"complete","x":780,"y":140,"questId":"q_zirui_brother","text":""},{"id":"n_turn","type":"npc","x":1020,"y":140,"text":"活着？……行。这几个钱拿着。别跟他说是我让你去的。"},{"id":"e_turn","type":"end","x":1300,"y":140},{"id":"c_act","type":"condition","x":780,"y":300,"cond":"questActive","condValue":"q_zirui_brother","text":""},{"id":"n_act","type":"npc","x":1040,"y":300,"text":"我哥呢？乌昂·兆迎。见到人没有？"},{"id":"ch_act","type":"choice","x":1300,"y":280,"text":"","options":[{"id":"o1","text":"还没，我再去。"},{"id":"o2","text":"你为什么不自己去？"}]},{"id":"n_a1","type":"npc","x":1560,"y":240,"text":"去。别站在斧子这边。"},{"id":"e_a1","type":"end","x":1800,"y":240},{"id":"n_a2","type":"npc","x":1560,"y":380,"text":"我去了，他会以为我突然信了。我偏，可我不想看他死。所以才找你这个陌生人。"},{"id":"e_a2","type":"end","x":1860,"y":380},{"id":"n1","type":"npc","x":1040,"y":500,"text":"别靠太近。我是乌昂·子睿。兆迎是我哥。他信神，我信斧子。我们早就不一起走路了。先锋部队来时我在砍柴，所以没死。"},{"id":"ch","type":"choice","x":1360,"y":480,"text":"","options":[{"id":"o1","text":"我去教堂村看看他。"},{"id":"o2","text":"你们兄弟的事，自己了断。"},{"id":"o3","text":"你恨他信神？"}]},{"id":"a1","type":"accept","x":1640,"y":400,"questId":"q_zirui_brother","text":""},{"id":"n_yes","type":"npc","x":1880,"y":400,"text":"别提我。我也不认识你。你叫{名}也好，叫别的也好。看见人，回来告诉我一声。"},{"id":"e_yes","type":"end","x":2160,"y":400},{"id":"n_no","type":"npc","x":1640,"y":560,"text":"行。斧子还在。我自己砍我的柴。"},{"id":"e_no","type":"end","x":1900,"y":560},{"id":"n_hate","type":"npc","x":1640,"y":700,"text":"不恨。恨的是他拿一座教堂当命。人可以不信神，不能不活着。"},{"id":"e_hate","type":"end","x":1920,"y":700}],"connections":[{"from":"s","to":"c_done","port":"out"},{"from":"c_done","to":"n_done","port":"yes"},{"from":"n_done","to":"e_done","port":"out"},{"from":"c_done","to":"c_goals","port":"no"},{"from":"c_goals","to":"k1","port":"yes"},{"from":"k1","to":"n_turn","port":"out"},{"from":"n_turn","to":"e_turn","port":"out"},{"from":"c_goals","to":"c_act","port":"no"},{"from":"c_act","to":